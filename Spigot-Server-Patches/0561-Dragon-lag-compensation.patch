+    // MCSR start - dragon lag compensation
+    public static final int MCSR_PART_HISTORY_SIZE = 21;
+    private final double[][][] mcsrPartHistory = new double[MCSR_PART_HISTORY_SIZE][][];
+    private int mcsrPartHistoryIndex = -1;
+    private int mcsrPartHistoryCount = 0;
+
+    private void mcsrRecordPartPositions() {
+        double[][] positions = new double[this.children.length][];
+        for (int i = 0; i < this.children.length; ++i) {
+            positions[i] = new double[] { this.children[i].locX(), this.children[i].locY(), this.children[i].locZ() };
+        }
+        this.mcsrPartHistoryIndex = (this.mcsrPartHistoryIndex + 1) % MCSR_PART_HISTORY_SIZE;
+        this.mcsrPartHistory[this.mcsrPartHistoryIndex] = positions;
+        this.mcsrPartHistoryCount = Math.min(this.mcsrPartHistoryCount + 1, MCSR_PART_HISTORY_SIZE);
+    }
+
+    @Nullable
+    public double[][] mcsrGetPartPositions(int ticksAgo) {
+        if (this.mcsrPartHistoryCount == 0) {
+            return null;
+        }
+        ticksAgo = Math.max(0, Math.min(ticksAgo, this.mcsrPartHistoryCount - 1));
+        return this.mcsrPartHistory[Math.floorMod(this.mcsrPartHistoryIndex - ticksAgo, MCSR_PART_HISTORY_SIZE)];
+    }
+    // MCSR end
+
     private void a(EntityComplexPart entitycomplexpart, double d0, double d1, double d2) {
         entitycomplexpart.setPosition(this.locX() + d0, this.locY() + d1, this.locZ() + d2);
     }
