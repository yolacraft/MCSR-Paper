+    // MCSR start - dragon lag compensation
+    @Nullable
+    public static EntityPlayer mcsrCompensationPlayer;
+    private final Map<EntityEnderDragon, double[][]> mcsrSavedPartPositions = Maps.newHashMap();
+
+    private List<EntityEnderDragon> mcsrRewindDragonParts(AxisAlignedBB searchBox) {
+        EntityPlayer player = mcsrCompensationPlayer;
+        if (!com.destroystokyo.paper.PaperConfig.mcsrDragonLagCompensation || player == null || this.world.isClientSide) {
+            return Collections.emptyList();
+        }
+        int ticks = MathHelper.clamp(Math.round(player.ping / 50.0F) + com.destroystokyo.paper.PaperConfig.mcsrDragonLagCompensationTickOffset, 0, Math.min(com.destroystokyo.paper.PaperConfig.mcsrDragonLagCompensationMaxTicks, EntityEnderDragon.MCSR_PART_HISTORY_SIZE - 1));
+
+        List<EntityEnderDragon> dragons = this.world.a(EntityEnderDragon.class, searchBox.g(16.0D), (dragon) -> !dragon.dead);
+        if (ticks == 0 || dragons.isEmpty()) {
+            return Collections.emptyList();
+        }
+        for (EntityEnderDragon dragon : dragons) {
+            double[][] history = dragon.mcsrGetPartPositions(ticks);
+            if (history == null) {
+                continue;
+            }
+            EntityComplexPart[] parts = dragon.getComplexParts();
+            double[][] current = new double[parts.length][];
+            for (int n = 0; n < parts.length; ++n) {
+                current[n] = new double[] { parts[n].locX(), parts[n].locY(), parts[n].locZ() };
+                parts[n].setPosition(history[n][0], history[n][1], history[n][2]);
+            }
+            this.mcsrSavedPartPositions.put(dragon, current);
+        }
+        return dragons;
+    }
 
+    private void mcsrRestoreDragonParts(List<EntityEnderDragon> dragons) {
+        for (EntityEnderDragon dragon : dragons) {
+            double[][] current = this.mcsrSavedPartPositions.remove(dragon);
+            if (current == null) {
+                continue;
+            }
+            EntityComplexPart[] parts = dragon.getComplexParts();
+            for (int n = 0; n < parts.length; ++n) {
+                parts[n].setPosition(current[n][0], current[n][1], current[n][2]);
+            }
+        }
     }
+    // MCSR end
 
